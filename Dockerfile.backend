# Estágio 1: Build
# 🚨 MUDANÇA CRÍTICA: Trocando 'alpine' por 'slim' (Debian glibc) para suportar binários nativos em Rust
FROM node:20-slim AS builder
WORKDIR /app

# Copia configurações do workspace
COPY package*.json ./
COPY packages/api/package.json packages/api/
COPY packages/mcp-server/package.json packages/mcp-server/

# 🚨 MUDANÇA CRÍTICA: Em vez de 'npm ci', usamos 'npm install' forçando
# a arquitetura linux e o processador x64, garantindo que o binário em Rust desça!
RUN npm install --os=linux --cpu=x64 --include=optional

# Copia o código fonte
COPY packages/api packages/api
COPY packages/mcp-server packages/mcp-server

# Builda os dois pacotes
RUN npm --workspace=packages/mcp-server run build
RUN npm --workspace=packages/api run build


# Estágio 2: Produção (Imagem mais leve)
# 🚨 A imagem final também precisa ser 'slim' para rodar o binário compilado
FROM node:20-slim
WORKDIR /app

# Instala dependências de sistema que o LiteParse/Tesseract podem precisar (opcional, mas recomendado)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/api/dist ./packages/api/dist
COPY --from=builder /app/packages/api/package.json ./packages/api/
COPY --from=builder /app/packages/mcp-server/dist ./packages/mcp-server/dist
COPY --from=builder /app/packages/mcp-server/package.json ./packages/mcp-server/

# A porta que o seu Express usa
EXPOSE 3333

# O comando para iniciar a API
CMD ["node", "packages/api/dist/server.js"]